# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017)
# Note: If no MongoDB server is running, the app automatically runs in resilient local fallback mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=doc_qa_assistant

# JWT Security
JWT_SECRET=super-secret-doc-qa-jwt-key-change-in-prod-2025
