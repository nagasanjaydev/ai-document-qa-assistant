# Google Gemini API Key (Get your key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Gemini Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# MongoDB Configuration (Local instance or MongoDB Atlas connection URI)
# Note: If no MongoDB server is running, the app automatically runs in resilient local fallback mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=doc_qa_assistant

# JWT Security
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production_2025

# Application Settings
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
